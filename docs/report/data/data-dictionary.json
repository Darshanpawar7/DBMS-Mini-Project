[{"table_name":"STUDENT","comment":"Registered user. role = student | admin (platform moderator).","checks":[{"name": "chk_student_email", "definition": "CHECK (((email)::text ~* '^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$'::text))"}, {"name": "chk_student_name", "definition": "CHECK ((length(btrim((full_name)::text)) >= 2))"}, {"name": "chk_student_pwd_bcrypt", "definition": "CHECK (((password_hash)::text ~ '^\\$2[aby]\\$[0-9]{2}\\$[./A-Za-z0-9]{53}$'::text))"}, {"name": "chk_student_role", "definition": "CHECK (((role)::text = ANY ((ARRAY['student'::character varying, 'admin'::character varying])::text[])))"}, {"name": "student_year_of_study_check", "definition": "CHECK (((year_of_study >= 1) AND (year_of_study <= 6)))"}],"ord":1,"columns":[{"column" : "student_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "full_name", "type" : "varchar(100)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Display name; trimmed by trigger."}, {"column" : "email", "type" : "varchar(120)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Login id; lower-cased by trigger, unique case-insensitively."}, {"column" : "password_hash", "type" : "varchar(255)", "not_null" : true, "default" : "", "keys" : null, "comment" : "bcrypt hash (cost 10); CHECK rejects anything else."}, {"column" : "program", "type" : "varchar(80)", "not_null" : false, "default" : "", "keys" : null, "comment" : "Degree programme, e.g. B.Tech CSE."}, {"column" : "year_of_study", "type" : "smallint", "not_null" : false, "default" : "", "keys" : null, "comment" : "Year 1-6."}, {"column" : "created_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Registration time."}, {"column" : "role", "type" : "varchar(10)", "not_null" : true, "default" : "'student'", "keys" : null, "comment" : "System role: student or admin."}, {"column" : "is_active", "type" : "boolean", "not_null" : true, "default" : "true", "keys" : null, "comment" : "Admins can deactivate an account without deleting its data."}, {"column" : "last_login_at", "type" : "timestamptz", "not_null" : false, "default" : "", "keys" : null, "comment" : "Updated on every successful login."}]}, 
 {"table_name":"COURSE","comment":"A course offered in the programme; scopes documents, enrollments and groups.","checks":[{"name": "chk_course_code", "definition": "CHECK (((course_code)::text ~ '^[A-Z0-9-]{3,20}$'::text))"}, {"name": "chk_course_title", "definition": "CHECK ((length(btrim((course_title)::text)) >= 3))"}],"ord":2,"columns":[{"column" : "course_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "course_code", "type" : "varchar(20)", "not_null" : true, "default" : "", "keys" : "UQ", "comment" : "University course code, e.g. UE23CS351A."}, {"column" : "course_title", "type" : "varchar(150)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Course name."}, {"column" : "department", "type" : "varchar(80)", "not_null" : false, "default" : "", "keys" : null, "comment" : "Offering department."}]}, 
 {"table_name":"DOCUMENT","comment":"An uploaded note/paper with its extracted text and access level.","checks":[{"name": "chk_document_course_vis", "definition": "CHECK ((((visibility)::text <> 'course'::text) OR (course_id IS NOT NULL)))"}, {"name": "chk_document_embedding", "definition": "CHECK (((embedding_status)::text = ANY ((ARRAY['pending'::character varying, 'ready'::character varying, 'failed'::character varying])::text[])))"}, {"name": "chk_document_file_size", "definition": "CHECK (((file_size_bytes IS NULL) OR ((file_size_bytes >= 1) AND (file_size_bytes <= 10485760))))"}, {"name": "chk_document_file_type", "definition": "CHECK (((file_type)::text = ANY ((ARRAY['pdf'::character varying, 'txt'::character varying, 'md'::character varying])::text[])))"}, {"name": "chk_document_title", "definition": "CHECK ((length(btrim((title)::text)) >= 3))"}, {"name": "document_visibility_check", "definition": "CHECK (((visibility)::text = ANY ((ARRAY['public'::character varying, 'course'::character varying, 'private'::character varying])::text[])))"}],"ord":3,"columns":[{"column" : "doc_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "title", "type" : "varchar(200)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Title shown in listings (search weight A)."}, {"column" : "file_path", "type" : "varchar(255)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Random stored file name (never the client name)."}, {"column" : "file_type", "type" : "varchar(20)", "not_null" : true, "default" : "", "keys" : null, "comment" : "pdf | txt | md."}, {"column" : "visibility", "type" : "varchar(10)", "not_null" : true, "default" : "'private'", "keys" : null, "comment" : "public = everyone, course = enrolled students, private = owner only."}, {"column" : "upload_date", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Upload time."}, {"column" : "student_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → STUDENT", "comment" : "Owner (UPLOADS)."}, {"column" : "course_id", "type" : "integer", "not_null" : false, "default" : "", "keys" : "FK → COURSE", "comment" : "Course the note belongs to (BELONGS_TO); optional."}, {"column" : "description", "type" : "varchar(500)", "not_null" : false, "default" : "", "keys" : null, "comment" : "One-line summary (search weight B)."}, {"column" : "content", "type" : "text", "not_null" : false, "default" : "", "keys" : null, "comment" : "Plain text extracted from the uploaded file."}, {"column" : "file_size_bytes", "type" : "integer", "not_null" : false, "default" : "", "keys" : null, "comment" : "Size of the uploaded file, 1 B - 10 MB."}, {"column" : "embedding_status", "type" : "varchar(10)", "not_null" : true, "default" : "'pending'", "keys" : null, "comment" : "pending until every chunk has an embedding, then ready."}, {"column" : "updated_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Last edit, stamped by trigger."}, {"column" : "search_tsv", "type" : "tsvector", "not_null" : false, "default" : "generated", "keys" : null, "comment" : "Generated weighted tsvector: title (A), description (B), content (C)."}]}, 
 {"table_name":"TAG","comment":"Normalised topic label (lower-case, hyphenated).","checks":[{"name": "chk_tag_name", "definition": "CHECK (((tag_name)::text ~ '^[a-z0-9][a-z0-9+#.-]{0,49}$'::text))"}],"ord":4,"columns":[{"column" : "tag_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "tag_name", "type" : "varchar(50)", "not_null" : true, "default" : "", "keys" : "UQ", "comment" : "Normalised label, e.g. query-optimization."}]}, 
 {"table_name":"STUDY_GROUP","comment":"A study group run for one course, capped at max_members.","checks":[{"name": "chk_group_max_members", "definition": "CHECK (((max_members >= 2) AND (max_members <= 20)))"}, {"name": "chk_group_name", "definition": "CHECK ((length(btrim((group_name)::text)) >= 3))"}],"ord":5,"columns":[{"column" : "group_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "group_name", "type" : "varchar(100)", "not_null" : true, "default" : "", "keys" : "UQ", "comment" : "Unique within its course."}, {"column" : "max_members", "type" : "smallint", "not_null" : true, "default" : "6", "keys" : null, "comment" : "Seat limit 2-20, enforced by trigger on join."}, {"column" : "created_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Creation time."}, {"column" : "course_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → COURSE, UQ", "comment" : "Course the group is run for (RUN_FOR)."}, {"column" : "created_by", "type" : "integer", "not_null" : false, "default" : "", "keys" : "FK → STUDENT", "comment" : "Creator; NULL if the account was deleted (group survives)."}, {"column" : "description", "type" : "varchar(300)", "not_null" : false, "default" : "", "keys" : null, "comment" : "What the group works on."}]}, 
 {"table_name":"SEARCH_LOG","comment":"Every search a student runs; also an interest signal for matching.","checks":[{"name": "chk_search_count", "definition": "CHECK (((result_count IS NULL) OR (result_count >= 0)))"}, {"name": "chk_search_mode", "definition": "CHECK (((search_mode)::text = ANY ((ARRAY['keyword'::character varying, 'semantic'::character varying, 'hybrid'::character varying])::text[])))"}, {"name": "chk_search_query", "definition": "CHECK ((length(btrim((query_text)::text)) >= 2))"}],"ord":6,"columns":[{"column" : "log_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "query_text", "type" : "varchar(255)", "not_null" : true, "default" : "", "keys" : null, "comment" : "What the student typed."}, {"column" : "searched_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Search time."}, {"column" : "student_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → STUDENT", "comment" : "Who searched (SEARCHES)."}, {"column" : "search_mode", "type" : "varchar(10)", "not_null" : true, "default" : "'hybrid'", "keys" : null, "comment" : "keyword | semantic | hybrid."}, {"column" : "result_count", "type" : "integer", "not_null" : false, "default" : "", "keys" : null, "comment" : "Hits returned; 0 marks a content gap."}, {"column" : "query_embedding", "type" : "vector(384)", "not_null" : false, "default" : "", "keys" : null, "comment" : "Embedding of the query text; feeds the interest profile."}]}, 
 {"table_name":"ENROLLMENT","comment":"M:N STUDENT-COURSE per semester.","checks":[{"name": "chk_enrollment_semester", "definition": "CHECK (((semester)::text ~ '^[0-9]{4}-(ODD|EVEN)$'::text))"}],"ord":7,"columns":[{"column" : "student_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → STUDENT, PK", "comment" : "Enrolled student."}, {"column" : "course_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → COURSE, PK", "comment" : "Course taken."}, {"column" : "semester", "type" : "varchar(20)", "not_null" : true, "default" : "", "keys" : "PK", "comment" : "Format YYYY-ODD or YYYY-EVEN."}]}, 
 {"table_name":"DOCUMENT_TAG","comment":"M:N DOCUMENT-TAG.","checks":null,"ord":8,"columns":[{"column" : "doc_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → DOCUMENT, PK", "comment" : "Tagged document."}, {"column" : "tag_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → TAG, PK", "comment" : "Applied tag."}]}, 
 {"table_name":"BOOKMARK","comment":"M:N STUDENT-DOCUMENT saved items.","checks":null,"ord":9,"columns":[{"column" : "student_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → STUDENT, PK", "comment" : "Who saved it."}, {"column" : "doc_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → DOCUMENT, PK", "comment" : "Saved document."}, {"column" : "bookmarked_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "When it was saved."}]}, 
 {"table_name":"GROUP_MEMBERSHIP","comment":"M:N STUDENT-STUDY_GROUP with a per-group role.","checks":[{"name": "group_membership_role_check", "definition": "CHECK (((role)::text = ANY ((ARRAY['admin'::character varying, 'member'::character varying])::text[])))"}],"ord":10,"columns":[{"column" : "group_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → STUDY_GROUP, PK", "comment" : "Group joined."}, {"column" : "student_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → STUDENT, PK", "comment" : "Member."}, {"column" : "role", "type" : "varchar(10)", "not_null" : true, "default" : "'member'", "keys" : null, "comment" : "admin | member (per group)."}, {"column" : "joined_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Join time; oldest member inherits admin."}]}, 
 {"table_name":"DOC_CHUNK","comment":"Weak entity: ~800-char passage of a document plus its 384-d embedding.","checks":[{"name": "chk_chunk_embedded", "definition": "CHECK (((embedding IS NULL) = (embedded_at IS NULL)))"}, {"name": "doc_chunk_chunk_index_check", "definition": "CHECK ((chunk_index >= 0))"}, {"name": "doc_chunk_chunk_text_check", "definition": "CHECK ((length(chunk_text) > 0))"}],"ord":11,"columns":[{"column" : "chunk_id", "type" : "integer", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key (partial key is chunk_index)."}, {"column" : "doc_id", "type" : "integer", "not_null" : true, "default" : "", "keys" : "FK → DOCUMENT, UQ", "comment" : "Owning document (identifying FK)."}, {"column" : "chunk_index", "type" : "integer", "not_null" : true, "default" : "", "keys" : "UQ", "comment" : "Position of the passage inside its document."}, {"column" : "chunk_text", "type" : "text", "not_null" : true, "default" : "", "keys" : null, "comment" : "Passage text, at most 800 characters."}, {"column" : "embedding", "type" : "vector(384)", "not_null" : false, "default" : "", "keys" : null, "comment" : "384-d all-MiniLM-L6-v2 sentence embedding, L2-normalised."}, {"column" : "embedded_at", "type" : "timestamptz", "not_null" : false, "default" : "", "keys" : null, "comment" : "When the vector was computed."}]}, 
 {"table_name":"AUDIT_LOG","comment":"Append-only change history written by triggers.","checks":[{"name": "audit_log_action_check", "definition": "CHECK (((action)::text = ANY ((ARRAY['INSERT'::character varying, 'UPDATE'::character varying, 'DELETE'::character varying])::text[])))"}],"ord":12,"columns":[{"column" : "audit_id", "type" : "bigint", "not_null" : true, "default" : "serial", "keys" : "PK", "comment" : "Surrogate key."}, {"column" : "table_name", "type" : "varchar(40)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Table that changed."}, {"column" : "action", "type" : "varchar(10)", "not_null" : true, "default" : "", "keys" : null, "comment" : "INSERT | UPDATE | DELETE."}, {"column" : "row_pk", "type" : "varchar(40)", "not_null" : true, "default" : "", "keys" : null, "comment" : "Primary key of the changed row."}, {"column" : "actor_id", "type" : "integer", "not_null" : false, "default" : "", "keys" : "FK → STUDENT", "comment" : "User who made the change, read from the app.current_user_id setting."}, {"column" : "old_data", "type" : "jsonb", "not_null" : false, "default" : "", "keys" : null, "comment" : "Row before the change (JSONB, secrets removed)."}, {"column" : "new_data", "type" : "jsonb", "not_null" : false, "default" : "", "keys" : null, "comment" : "Row after the change (JSONB, secrets removed)."}, {"column" : "logged_at", "type" : "timestamptz", "not_null" : true, "default" : "CURRENT_TIMESTAMP", "keys" : null, "comment" : "Change time."}]}]
