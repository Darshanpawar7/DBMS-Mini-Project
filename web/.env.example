# Copy to .env.local. The DB password must match APP_DB_PASSWORD in ../.env
DATABASE_URL=postgres://scholarmesh_app:change-me-app-password@localhost:5433/scholarmesh
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
