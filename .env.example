# Copy to .env and fill in strong values. Used by docker compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_DB=scholarmesh
POSTGRES_PORT=5433
# Least-privilege login used by the web app (created by `npm run db:setup`)
APP_DB_USER=scholarmesh_app
APP_DB_PASSWORD=change-me-app-password
